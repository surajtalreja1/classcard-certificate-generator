---
// Static page served via Astro for Webflow Cloud (Cloudflare Workers) deployment.
---
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classcard | Cert-Gen V2</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Ballet:opsz@16..72&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="v2-ui">

    <aside class="sidebar">
        <div class="sidebar-header">
            <div>
                <a href="https://classcardapp.com/" target="_blank"
                    style="display: block; width: fit-content; text-decoration: none;">
                    <img id="ui-logo" src="" alt="Classcard" class="brand-logo">
                </a>
                <h2>Certificate Studio <span class="badge">V2</span></h2>
            </div>
            <button class="theme-toggle-btn" id="theme-toggle" onclick="toggleTheme()" title="Toggle Light/Dark Mode">
                <span id="theme-icon">🌙</span>
            </button>
        </div>

        <div class="scroll-content">
            <div class="control-group desktop-only">
                <label>Workspace Layout</label>
                <div style="display: flex; flex-direction: column; gap: 12px; padding: 4px 0;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Preview Zoom</span>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            <span id="preview-zoom-val" style="font-size: 10px; color: var(--classcard-blue);">Auto</span>
                            <button onclick="resetZoom()" style="background: none; border: none; color: var(--text-muted); font-size: 8px; cursor: pointer; text-transform: uppercase; font-weight: 700; padding: 2px 4px; border: 1px solid var(--border-ui); border-radius: 4px;">Reset</button>
                        </div>
                    </div>
                    <input type="range" id="preview-zoom-slider" min="0.3" max="1.5" step="0.01" value="0.9" class="slider-input" oninput="updateManualScale(this.value)">
                    
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                        <span style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Sidebar Width</span>
                        <span id="sidebar-width-val" style="font-size: 10px; color: var(--classcard-blue);">380px</span>
                    </div>
                    <input type="range" id="sidebar-width-slider" min="300" max="800" step="1" value="380" class="slider-input" oninput="updateSidebarWidth(this.value)">
                </div>
            </div>

            <div class="control-group">
                <label>Rank Seal</label>
                <div class="seal-selector" style="display: flex; gap: 8px; margin-bottom: 16px;">
                    <button class="seal-btn active" onclick="setSeal('none')" id="seal-none">None</button>
                    <button class="seal-btn seal-gold" onclick="setSeal('gold')" id="seal-gold">Gold</button>
                    <button class="seal-btn seal-silver" onclick="setSeal('silver')" id="seal-silver">Silver</button>
                    <button class="seal-btn seal-bronze" onclick="setSeal('bronze')" id="seal-bronze">Bronze</button>
                </div>
            </div>

            <div class="control-group">
                <label>Seal Rank & Label</label>
                <div class="seal-selector" style="display: flex; gap: 4px; margin-bottom: 8px;">
                    <button class="seal-btn active" onclick="setSeal('none')" id="btn-seal-none">OFF</button>
                    <button class="seal-btn" onclick="setSeal('gold')">GOLD</button>
                    <button class="seal-btn" onclick="setSeal('silver')">SILVER</button>
                    <button class="seal-btn" onclick="setSeal('bronze')">BRONZE</button>
                </div>
                <select id="seal-label-style" class="input-field" onchange="updateSealLabel()"
                    style="font-size: 10px; background: var(--bg-input); border-color: var(--border-ui); color: var(--text-main);">
                    <option value="ordinal">Use Ordinal (1st, 2nd, 3rd)</option>
                    <option value="name">Use Names (Gold, Silver, Bronze)</option>
                </select>
            </div>

            <div class="control-group">
                <label>Design Theme</label>
                <div class="skin-selector">
                    <div class="skin-option active" onclick="setSkin('plain')" data-skin="plain">
                        <div class="skin-preview plain"
                            style="background: white; border: 1px solid var(--border-ui); border-radius: 6px; height: 40px; margin-bottom: 4px;">
                        </div>
                        <span>Plain</span>
                    </div>
                    <div class="skin-option" onclick="setSkin('default')" data-skin="default">
                        <div class="skin-preview default"></div>
                        <span>Gymnastic</span>
                    </div>
                    <div class="skin-option" onclick="setSkin('dance')" data-skin="dance">
                        <div class="skin-preview dance"></div>
                        <span>Dance</span>
                    </div>
                    <div class="skin-option" onclick="setSkin('football')" data-skin="football">
                        <div class="skin-preview football"></div>
                        <span>Football</span>
                    </div>
                </div>
            </div>

            <div class="control-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label style="border:none; margin:0; padding:0;">Award Details</label>
                    <div class="mode-toggle">
                        <button class="toggle-btn active" id="mode-single" onclick="setEntryMode('single')">Single</button>
                        <button class="toggle-btn" id="mode-batch" onclick="setEntryMode('batch')">Batch</button>
                    </div>
                </div>
                <input type="text" id="tag-input" class="input-field" style="margin-bottom: 8px;"
                    placeholder="Badge Text" oninput="updatePreview()" value="Academy Award">
                
                <div id="single-name-container">
                    <input type="text" id="recipient-input" class="input-field" style="margin-bottom: 8px;"
                        placeholder="Full Name" oninput="updatePreview()" value="Alex Johnson">
                </div>

                <div id="batch-names-container" style="display: none;">
                    <textarea id="batch-names-input" class="input-field" style="height: 100px; resize: none; margin-bottom: 8px;"
                        placeholder="Enter names, one per line..." oninput="updatePreview()"></textarea>
                    <p style="font-size: 10px; color: var(--text-muted); margin-top: -4px; margin-bottom: 8px;">Each line will create a new certificate.</p>
                </div>

                <input type="text" id="title-input" class="input-field" placeholder="Award Title"
                    oninput="updatePreview()" value="Certificate of Achievement">
            </div>

            <div class="control-group">
                <label>Narrative</label>
                <textarea id="sub-input" class="input-field" style="height: 80px; resize: none;"
                    oninput="updatePreview()">For demonstrating exceptional commitment, leadership, and technical skill during the 2026 academy season.</textarea>
            </div>

            <div class="control-group">
                <label>Signature & Date Labels</label>
                <div class="input-row">
                    <input type="text" id="coach-label-input" class="input-field" placeholder="Label"
                        oninput="updatePreview()" value="Head Coach">
                    <input type="text" id="date-label-input" class="input-field" placeholder="Label"
                        oninput="updatePreview()" value="Date Issued">
                </div>
            </div>

            <div class="control-group">
                <label>Authorized By / When</label>
                <div class="input-row">
                    <input type="text" id="coach-input" class="input-field" placeholder="Name" oninput="updatePreview()"
                        value="Coach Smith">
                    <input type="text" id="date-input" class="input-field" placeholder="Date" oninput="updatePreview()"
                        value="April 2026">
                </div>
            </div>

            <div class="control-group">
                <label>Your Academy, Team or School Logo</label>
                <label for="logo-upload" class="custom-file-upload">
                    <i class="icon">↑</i> <span id="file-status">Upload Logo...</span>
                </label>
                <input type="file" id="logo-upload" class="file-input" accept="image/*"
                    onchange="handleLogoUpload(event)">
            </div>

        </div>

        <div class="sidebar-footer">
            <div class="v2-promo-card">
                <h4>Elevate your Academy</h4>
                <p>Automate scheduling & payments with Classcard.</p>
                <a href="https://app.classcardapp.com/signup/?_gl=1%2abqql3u%2a_gcl_au%2aNTQ4MjE1NDEwLjE3NzUyMDgxMTY"
                    target="_blank" class="btn btn-primary promo-btn">Try Classcard Free</a>
            </div>
            <div class="footer-actions">
                <button class="btn btn-primary" id="download-btn" onclick="handleDownload()" style="width: 100%;">Print / Save PDF</button>
            </div>
        </div>
    </aside>

    <div class="resizer" id="sidebar-resizer"></div>

    <main class="preview-container">
        <div id="preview-scaler">
            <div id="certificate-preview" class="cert-render-area skin-default">
                <img id="preview-bg-layer" class="cert-bg-layer" src="" alt="" style="object-fit: fill;">
                <div class="cert-content">
                    <div class="cert-tag" id="preview-tag">Academy Award</div>
                    <div id="preview-seal" class="cert-seal seal-none"></div>
                    <h1 class="cert-headline" id="preview-title">Certificate of Achievement</h1>
                    <p class="presented-text">This certificate is proudly presented to</p>
                    <div class="cert-recipient" id="preview-recipient">Alex Johnson</div>
                    <p class="cert-sub" id="preview-sub">For demonstrating exceptional commitment, leadership, and
                        technical skill during the 2026 academy season.</p>

                    <div class="signature-area">
                        <div class="sig-box">
                            <div class="sig-line" id="preview-coach-line"></div>
                            <p class="sig-name" id="preview-coach">Coach Smith</p>
                            <p class="sig-label" id="preview-coach-label">Head Coach</p>
                        </div>
                        <div class="sig-box">
                            <div class="sig-line" id="preview-date-line"></div>
                            <p class="sig-name" id="preview-date">April 2026</p>
                            <p class="sig-label" id="preview-date-label">Date issued</p>
                        </div>
                    </div>
                </div>

                <div class="cert-logo-container left">
                    <img id="preview-classcard-logo" class="has-src" src="" alt="Classcard Logo">
                </div>

                <div class="cert-logo-container">
                    <img id="preview-logo" src="" alt="Logo">
                </div>
            </div>
        </div>
    </main>

    <div class="mobile-nav">
        <button class="nav-btn active" id="btn-edit" onclick="switchMobileTab('edit')">BUILD</button>
        <button class="nav-btn" id="btn-view" onclick="switchMobileTab('view')">VIEW</button>
        <button class="nav-btn btn-save" onclick="handleDownload()">PDF</button>
        <a href="https://app.classcardapp.com/signup/?_gl=1%2abqql3u%2a_gcl_au%2aNTQ4MjE1NDEwLjE3NzUyMDgxMTY"
            target="_blank" class="nav-btn btn-cta">TRIAL</a>
    </div>

    <div id="status-toast"
        style="position: fixed; top: 20px; left: 50%; transform: translateX(-50%); background: #1a1a1a; color: white; padding: 12px 24px; border-radius: 100px; font-size: 13px; font-weight: 700; z-index: 1000; display: none; box-shadow: 0 10px 30px rgba(0,0,0,0.2); transition: all 0.3s; pointer-events: none;">
        Generating...
    </div>

    <!-- Hidden zone for Batch Printing (Ensures file:/// compatibility) -->
    <div id="batch-print-zone" style="display: none;"></div>

    <script is:inline src="/skins.js"></script>
    <script is:inline src="/app.js"></script>
</body>

</html>