---
// Static page served via Astro for Webflow Cloud (Cloudflare Workers) deployment.
// All assets are inlined because Webflow Cloud's Astro deployments do not
// reliably serve files from the `public/` directory or `_astro/` bundles.
import styleCss from "../assets/style.css?raw";
import appJs from "../assets/app.js?raw";
import danceSvg from "../assets/skins/dance.svg?raw";
import footballSvg from "../assets/skins/football.svg?raw";
import gymnasticsSvg from "../assets/skins/gymnastics.svg?raw";
import classcardLogoSvg from "../assets/skins/classcard-logo.svg?raw";

// Percent-encoded data URIs work in any runtime without needing Buffer/btoa.
const toDataUri = (svg: string) =>
  `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;

const SKINS_INLINE = {
  default: toDataUri(gymnasticsSvg),
  dance: toDataUri(danceSvg),
  football: toDataUri(footballSvg),
  logo: toDataUri(classcardLogoSvg),
};

// Override the SKINS object that skins.js sets, so the runtime JS uses the
// inline data URIs instead of trying to fetch the SVGs over HTTP.
const skinsBootstrap = `const SKINS = ${JSON.stringify(SKINS_INLINE)};`;
---
<!DOCTYPE html>
<html lang="en">

